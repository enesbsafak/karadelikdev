{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KaradelikDev",
  "version": "1.2.0",
  "identifier": "dev.karadelik.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "KaradelikDev",
        "url": "index.html",
        "width": 640,
        "height": 420,
        "minWidth": 560,
        "minHeight": 380,
        "resizable": true,
        "decorations": false,
        "center": true,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "enesbsafak",
    "copyright": "© 2026 enesbsafak · MIT",
    "homepage": "https://github.com/enesbsafak/karadelikdev",
    "shortDescription": "Windows için yerel geliştirme ortamı",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Turkish", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}