{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "dev.karadelik.desktop",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KaradelikDev",
        "url": "index.html",
        "width": 640,
        "height": 420,
        "minWidth": 560,
        "minHeight": 380,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 22
        },
        "theme": "Dark",
        "center": true,
        "visible": false,
        "shadow": true
      }
    ]
  },
  "bundle": {
    "targets": [
      "app",
      "dmg"
    ],
    "shortDescription": "macOS ve Windows için yerel geliştirme ortamı",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "dmg": {
        "windowSize": {
          "width": 600,
          "height": 380
        },
        "appPosition": {
          "x": 160,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 440,
          "y": 190
        }
      }
    }
  }
}
